# Comma-separated Instagram handles allowed in; read on the server only.
INSTAGRAM_WHITELIST=
# Public origin of the site (metadata, security.txt). A bare host gets https://; an invalid value is ignored.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 measurement ID (G-XXXXXXX); GA is not loaded when empty.
NEXT_PUBLIC_GA_ID=
