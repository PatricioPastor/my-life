// Database rules (see odd/tasks/memory-orb.md):
//  - snake_case in the database: every model/enum has @@map, every camelCase field has @map.
//  - Row-level security is enabled and forced on every table in the migration SQL.
//  - Columns the runtime role must not write use DB-side defaults (`dbgenerated`), so the
//    Prisma engine never sends them in an INSERT and the column-level GRANT can exclude them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemoryStatus {
  pending
  approved
  rejected

  @@map("memory_status")
}

/// Where a stored place came from: the photo's own GPS, or a Google Maps link the visitor pasted.
enum LocationSource {
  photo
  link

  @@map("location_source")
}

/// What kind of media a memory holds. Only `image` is stored: a memory is a photo, an audio or both, and which
/// it is gets derived from `public_id` and `audio_public_id`.
enum MediaKind {
  image

  @@map("media_kind")
}

/// A photo and/or an audio, a short caption and the date it happened, uploaded by an admitted visitor.
/// Stays `pending` until the owner approves it with a manual UPDATE. A CHECK requires a photo or an audio.
model Memory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The visitor's Instagram handle (normalized).
  handle     String       @db.VarChar(30)
  /// Cloudinary public id of the uploaded photo. Null for an audio-only memory.
  publicId   String?      @unique @map("public_id")
  caption    String       @db.VarChar(140)
  happenedOn DateTime     @map("happened_on") @db.Date
  /// The photo's size, from Cloudinary. Null exactly when there is no photo.
  width      Int?
  height     Int?
  status     MemoryStatus @default(dbgenerated("'pending'::memory_status"))
  createdAt  DateTime     @default(dbgenerated("now()")) @map("created_at") @db.Timestamptz(3)

  /// Server-computed from Cloudinary's answer (never from the browser). Nullable ones can be missing.
  kind           MediaKind @default(image)
  format         String?
  bytes          Int?
  /// EXIF DateTimeOriginal (plus OffsetTimeOriginal), when present and valid.
  takenAt        DateTime? @map("taken_at") @db.Timestamptz(3)
  /// `#rrggbb` of the most prominent color.
  dominantColor  String?   @map("dominant_color") @db.VarChar(7)
  /// The top few colors: [{ "color": "#rrggbb", "share": 12.3 }]. Not sent to the client.
  palette        Json      @default("[]")
  /// Whitelisted, non-identifying EXIF fields. Never GPS, serials or owner names. Not sent to the client.
  metadata       Json      @default("{}")
  /// Exact position of the photo (6 decimals, about 10 cm). Set only when the visitor opted in.
  /// The client only ever gets it rounded to 2 decimals; Nominatim too.
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  /// Short human label of the location (neighbourhood and city). Only with a location.
  placeName      String?         @map("place_name") @db.VarChar(120)
  /// Set if and only if the location is.
  locationSource LocationSource? @map("location_source")
  /// The color of the memory's orb, `#rrggbb`, chosen by the visitor from their photo (or derived by the server).
  /// Null only for rows stored before orb colors existed; the client always gets one.
  orbColor       String?         @map("orb_color") @db.VarChar(7)

  /// The voice of the memory: a Cloudinary `video`-type resource (that is how it stores audio), `authenticated`.
  /// All four columns are set together or all null, and only the server writes them, from Cloudinary's answer.
  audioPublicId   String? @unique @map("audio_public_id")
  /// Lowercase format of the original upload (`webm`, `m4a`...). Playback is always an mp3 transcode.
  audioFormat     String? @map("audio_format")
  audioBytes      Int?    @map("audio_bytes")
  audioDurationMs Int?    @map("audio_duration_ms")

  @@index([status, happenedOn], map: "memories_status_happened_on_idx")
  @@index([handle, createdAt], map: "memories_handle_created_at_idx")
  @@map("memories")
}
